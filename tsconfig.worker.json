{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2022"]
  },
  "include": ["src/worker.ts", "src/polar-api.ts", "src/types.ts", "src/auth/**/*.ts", "src/webhook/**/*.ts", "src/archive/**/*.ts", "src/providers/**/*.ts", "src/insights/**/*.ts"],
  "exclude": ["node_modules", "src/webhook/register-cli.ts", "src/providers/strava/import-cli.ts"]
}
